APP_NAME="Webxpress Technologies"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Security settings for deployment
TRUSTED_PROXIES=
TRUSTED_HEADERS=30
FORCE_HTTPS=false
SESSION_SECURE_COOKIE=false

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily, not single. A single log file grows without bound until it fills the
# disk, which on a web server takes the whole site down and usually takes the
# log with it. daily rotates and config/logging.php sets the retention.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# MySQL. Use a *_dev database name for local work: development and production
# must never be the same database. A stray migrate:fresh in development should
# be able to cost you an afternoon, not the site.
#
#   local:      DB_DATABASE=webxpress_dev
#   production: DB_DATABASE=webxpress
#
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=webxpress_dev
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_INQUIRIES_TO="hello@example.com"
MAIL_INQUIRIES_AUTO_ACK=true
MAIL_AI_FOLLOW_UP=true
MAIL_AI_AUTO_REPLY=true
MAIL_AI_AUTO_REPLY_MAX=2

# AI reply drafts (OpenRouter-compatible API)
AI_API_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=anthropic/claude-3.5-haiku

# Paystack payments
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# IMAP reply fetcher (auto-reply when clients respond by email)
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USERNAME=
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# IMAP_PROTOCOL=imap
# IMAP_ENCRYPTION=ssl

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Panel administrator provisioned by AdminUserSeeder on a fresh deploy.
#
# ADMIN_EMAIL is the ONLY thing that grants panel access, and it fails CLOSED:
# leave it empty and the panel is locked for everyone, including you. That is
# deliberate — an unset value is far more often a deploy mistake than an
# intention, and the old behaviour (empty meant "anyone logged in") left every
# page, post, review, deal and payment open to any account that could
# authenticate. There is no local bypass; set these values instead.
#
# Password min 12 chars. Never commit a real password here.
ADMIN_NAME="Webxpress Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The URL segment the admin panel answers on. Change this on any real deploy.
#
# Mint one with:  php artisan tinker --execute="echo 'panel-'.Str::random(24);"
#
# Be clear about what this buys you. A path a scanner cannot guess means an
# unauthenticated bot never finds the login form, which removes the cheap target
# and most of the log noise. It is NOT a security control on its own — the path
# leaks from a bookmark, a Referer header, a screenshot, or anyone with read
# access to the repository. What actually holds the panel is the fail-closed
# ADMIN_EMAIL check above, the throttling below, and a real password.
#
# Changing it is safe. The panel follows this value, the CMS catch-all reserves
# the segment so no CMS page can be created on top of it, and the admin emails
# that link into the panel read it from here too.
ADMIN_PATH=admin

# How many wrong passwords one admin account will accept before it is locked out
# for the decay window, counted across every source address.
#
# Filament already caps attempts per IP. This cap is keyed on the account being
# targeted, so rotating source addresses cannot buy more guesses. The tradeoff is
# that anyone can lock the real admin out on purpose by hammering the address —
# which is the correct direction, since an account under sustained guessing is
# worth knowing about. Widen the window rather than removing the limit.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_DECAY_SECONDS=300

# Content Security Policy. Enforced by default. CSP_REPORT_ONLY flips the header
# to Report-Only so browsers log violations without blocking anything — turn it
# on first the day you intend to change config/csp.php, verify nothing critical
# is blocked, then flip it back off.
CSP_ENABLED=true
CSP_REPORT_ONLY=false
# Optional endpoint that receives violation reports. Empty = none, which still
# shows violations in each visitor's devtools console.
CSP_REPORT_URI=

# Status site data directory (public status page is at status/, deployed
# separately to Cloudflare Pages). Only status:publish writes here.
STATUS_PATH=

# Destructive-command escape hatch. Leave FALSE, and always.
#
# migrate:fresh, migrate:reset, migrate:refresh, db:wipe and db:clear drop every
# table. They are refused in any environment that is not local or testing,
# because the command line is identical either side of that line and only the
# .env differs. Setting this to true lifts the refusal.
#
# Set it for ONE command, in the environment that is about to lose its data, and
# take a backup first:
#
#     ALLOW_DESTRUCTIVE_COMMANDS=true php artisan migrate:fresh
#
# Never put it in a deployed .env. If you find yourself wanting to, the answer
# is a database backup, not this flag.
ALLOW_DESTRUCTIVE_COMMANDS=false

VITE_APP_NAME="${APP_NAME}"
