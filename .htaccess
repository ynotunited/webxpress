Options -Indexes

# Never serve the environment file or git metadata from the web root.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^\.git(/|$) - [F,L,NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
